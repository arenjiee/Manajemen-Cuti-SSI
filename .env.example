# # Salin menjadi .env.local lalu ganti PASSWORD_KAMU.
# # Nama database mengikuti yang dibuat di pgAdmin (huruf besar/kecil harus sama persis).
# DATABASE_URL=postgresql://postgres:PASSWORD_KAMU@localhost:5432/SSI_manajemen_cuti

# # Hanya untuk `npm test`: database KOSONG terpisah. Isinya akan DIHAPUS setiap tes dijalankan.
# DATABASE_URL_TEST=postgresql://postgres:PASSWORD_KAMU@localhost:5432/smck_test

# # String acak minimal 32 karakter untuk menandatangani cookie sesi.
# SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# # Isi false hanya jika menjalankan `npm start` lewat http di luar localhost.
# COOKIE_SECURE=false

# Salin menjadi .env.local lalu ganti PASSWORD_KAMU.
DATABASE_URL=postgresql://postgres:PASSWORD_KAMU@@localhost:5432/SSI_manajemen_cuti

# Hanya untuk `npm test`: database KOSONG terpisah. Isinya akan DIHAPUS setiap tes dijalankan.
DATABASE_URL_TEST=postgresql://postgres:PASSWORD_KAMU@@localhost:5432/smck_test

# String acak minimal 32 karakter untuk menandatangani cookie sesi.
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter